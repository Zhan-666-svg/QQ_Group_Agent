{
  "description": "L1 快速过滤规则 (先于大模型执行，0 Token 成本快速过滤 95% 无关闲聊)",
  "rules": {
    "include_keywords": [
      "省",
      "市",
      "区",
      "街道",
      "小区",
      "发顺丰",
      "顺丰",
      "小鸭",
      "烘干",
      "高温",
      "KA",
      "WBH",
      "求购",
      "收购",
      "想买",
      "收一个",
      "收台",
      "需要",
      "寻找",
      "报价",
      "多少钱",
      "预算",
      "现货",
      "货源",
      "批发",
      "代理",
      "合作",
      "对接",
      "微信"
    ],
    "exclude_keywords": [
      "签到",
      "打卡",
      "撤回了一条消息",
      "加入群聊",
      "被管理员禁言",
      "欢迎新成员"
    ],
    "regex_patterns": [
      "(?<!\\d)1[3-9]\\d{9}(?:[-_#转]\\d{3,6})?(?!\\d)",
      "(?<!\\d)\\d{15,25}(?!\\d)",
      "\\d+(?:\\.\\d+)?(?:高端|热烘干|烘干|洗|公斤|kg)"
    ]
  }
}
